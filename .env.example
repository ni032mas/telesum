# Telegram API credentials (https://my.telegram.org)
TG_API_ID=
TG_API_HASH=

# Source chats to read messages from (comma-separated IDs or usernames)
SOURCE_CHAT=

# Bot mode (optional)
TG_BOT_TOKEN=
DEST_USER_ID=

# Userbot destination chats (optional, comma-separated)
DEST_CHAT=

# Summarization settings
HOURS_BACK=24
LLM_CLI=claude
LLM_MODEL=sonnet

# Telegram session (auto-filled after auth)
TG_SESSION=
